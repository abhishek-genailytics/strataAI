# StrataAI Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real secrets to version control

# App Configuration
PROJECT_NAME=StrataAI
API_V1_STR=/api/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Feature Flags
FORCE_ECHO_ADAPTER=false
ENABLE_REQUEST_LOGGING=true
ENABLE_USAGE_ROLLUPS=true
ENABLE_PLAYGROUND_LOGGING=true

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Encryption (Fernet key for API key storage)
ENCRYPTION_KEY=

# OpenAI Provider Configuration
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CONNECT_TIMEOUT_S=10
OPENAI_READ_TIMEOUT_S=60
OPENAI_WRITE_TIMEOUT_S=60

# Anthropic Provider Configuration
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_CONNECT_TIMEOUT_S=10
ANTHROPIC_READ_TIMEOUT_S=60
ANTHROPIC_WRITE_TIMEOUT_S=60

# Legacy Configuration (for backward compatibility)
SUPABASE_JWT_SECRET=
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=false
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10
CACHE_TTL_DEFAULT=300
CACHE_TTL_MODELS=3600
CACHE_TTL_ANALYTICS=60
CACHE_ENABLED=false
OPENAI_TOTAL_TIMEOUT_S=65
ANTHROPIC_TOTAL_TIMEOUT_S=65
